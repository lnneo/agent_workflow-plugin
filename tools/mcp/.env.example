PORT=3030

# Enable/disable MCP modules
MCP_PG_ENABLED=true
MCP_REDIS_ENABLED=true
MCP_HANDOFF_ENABLED=true
MCP_BACKLOG_ENABLED=false

# Backlog configuration (required when MCP_BACKLOG_ENABLED=true)
# BACKLOG_DOMAIN=your-space.backlog.com
# BACKLOG_API_KEY=your-api-key
# BACKLOG_TOOLSETS=all
# BACKLOG_OPTIMIZE_RESPONSE=false
# BACKLOG_MAX_TOKENS=50000

# PostgreSQL connection string (must include database name in path)
PG_URL=postgresql://postgres:postgres@host.docker.internal:5432/postgres

# Redis connection string
REDIS_URL=redis://host.docker.internal:6379

# Handoff SQLite path (defaults to ./data/handoff.sqlite locally, /app/data/handoff.sqlite in Docker)
# HANDOFF_MCP_DB=./data/handoff.sqlite

# Optional: host projects root mounted at the same path inside Docker for /handoff-sync git scanning
# PROJECTS_DIR=/Users/yourname/Projects
